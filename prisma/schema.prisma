// Elo · modelo de dados
// SQLite para rodar local sem instalar nada; troque o provider para "postgresql" em produção.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Pessoa que entra na plataforma: representante de uma PME ou engenheiro/estudante.
model User {
  id        String    @id @default(cuid())
  name      String
  email        String    @unique
  passwordHash String?
  isDemo       Boolean   @default(false)
  role         String // "COMPANY" | "ENGINEER"
  companyId String?
  company   Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  engineer  Engineer?
  updates       RequestUpdate[]
  sessions      Session[]
  notifications Notification[]
  createdAt     DateTime  @default(now())
}

/// Sessão de login (token aleatório guardado em cookie httpOnly).
model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

/// Aviso para um usuário: proposta recebida, demanda assumida, nova mensagem…
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String?
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

/// Pequena ou média indústria cadastrada na rede.
model Company {
  id        String   @id @default(cuid())
  name        String
  initials    String
  cnpj        String?
  sector      String // chave de SECTORS em src/lib/sectors.ts
  description String?
  onboardedAt DateTime?
  size      String // "Micro" | "Pequena" | "Média"
  employees Int
  city      String
  lat       Float
  lng       Float
  createdAt DateTime @default(now())

  users            User[]
  flows            MaterialFlow[]
  inputs           InputDemand[]
  sentExchanges    Exchange[]       @relation("ExchangeFrom")
  receivedExchanges Exchange[]      @relation("ExchangeTo")
  requests         SupportRequest[]
}

/// Um insumo que a empresa compra e a parte dele que vira resíduo (valores mensais).
model MaterialFlow {
  id               String   @id @default(cuid())
  companyId        String
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name             String
  category         String // chave de CATEGORIES em src/lib/catalog.ts
  unit             String // "kg" | "L" | "un"
  monthlyQty       Float
  unitCost         Float // R$ por unidade comprada
  lossRate         Float // 0..1
  destination      String // chave de DESTINATIONS
  destinationValue Float // R$ por unidade de resíduo: + receita, − custo de descarte
  supplier         String?
  lot              String?
  leverText        String? // alavanca técnica sugerida para reduzir a perda
  leverReduction   Float? // redução relativa típica (0..1)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  exchanges Exchange[]
  records   MonthlyRecord[]
}

/// Fotografia mensal de um fluxo, para histórico e tendência.
model MonthlyRecord {
  id         String       @id @default(cuid())
  flowId     String
  flow       MaterialFlow @relation(fields: [flowId], references: [id], onDelete: Cascade)
  month      String // "AAAA-MM"
  monthlyQty Float
  unitCost   Float
  lossRate   Float
  destination      String
  destinationValue Float

  @@unique([flowId, month])
}

/// O que uma empresa aceita receber como insumo (base do matching de simbiose).
model InputDemand {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category     String
  description  String
  use          String // o que ela faz com o material
  pricePaid    Float // R$ por unidade que paga pelo resíduo (negativo = cobra para receber)
  virginPrice  Float // R$ por unidade do material novo que esse resíduo substitui
  capacity     Float // unidades por mês que consegue absorver
  substitution Float // fração de matéria-prima virgem evitada (0..1)
  licensed     Boolean  @default(false) // licença para receber resíduo perigoso (Classe I)
  createdAt    DateTime @default(now())

  exchanges Exchange[]
}

/// Proposta de troca de resíduo entre duas empresas.
model Exchange {
  id         String       @id @default(cuid())
  flowId     String
  flow       MaterialFlow @relation(fields: [flowId], references: [id], onDelete: Cascade)
  demandId   String
  demand     InputDemand  @relation(fields: [demandId], references: [id], onDelete: Cascade)
  fromId     String
  from       Company      @relation("ExchangeFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toId       String
  to         Company      @relation("ExchangeTo", fields: [toId], references: [id], onDelete: Cascade)
  initiatorId String // empresa que fez a proposta; a outra responde
  quantity   Float // unidades por mês
  price      Float // R$ por unidade
  status     String       @default("PROPOSED") // PROPOSED | ACCEPTED | DECLINED
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
}

/// Perfil técnico de quem atende as demandas.
model Engineer {
  id           String  @id @default(cuid())
  userId       String  @unique
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind         String // "STUDENT" | "MENTOR"
  course       String
  bio          String
  skills       String // lista separada por vírgula
  hoursPerWeek Int
  rating       Float
  lat          Float
  lng          Float

  invited  SupportRequest[] @relation("Invited")
  assigned SupportRequest[] @relation("Assigned")
}

/// Pedido de apoio técnico de uma PME para a rede de engenheiros.
model SupportRequest {
  id             String   @id @default(cuid())
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title          String
  category       String
  briefing       String
  estimatedHours Int
  monthlyLoss    Float
  status         String   @default("OPEN") // OPEN | IN_PROGRESS | DONE
  invitedId      String?
  invited        Engineer? @relation("Invited", fields: [invitedId], references: [id], onDelete: SetNull)
  assigneeId     String?
  assignee       Engineer? @relation("Assigned", fields: [assigneeId], references: [id], onDelete: SetNull)
  outcome        String? // resultado registrado ao concluir
  savedPerMonth  Float? // economia mensal validada ao concluir
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  updates RequestUpdate[]
}

/// Mensagens e eventos na linha do tempo de uma demanda.
model RequestUpdate {
  id        String         @id @default(cuid())
  requestId String
  request   SupportRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?          @relation(fields: [authorId], references: [id], onDelete: SetNull)
  kind      String         @default("MESSAGE") // MESSAGE | EVENT
  body      String
  createdAt DateTime       @default(now())
}
